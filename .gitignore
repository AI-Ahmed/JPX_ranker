# ============================================================================
# JPX Ranker - .gitignore
# Focus: Keep only modular source code, ignore all data/cache/outputs
# ============================================================================

# ============================================================================
# PYTHON ENVIRONMENT & DEPENDENCIES
# ============================================================================
# Virtual environments
.env
.venv/
venv/
ENV/
env/
.python-version

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# CatBoost model artifacts
catboost_info/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ============================================================================
# KAGGLE DATA & COMPETITION FILES
# ============================================================================
# All Kaggle input data (downloaded datasets)
kaggle/
kaggle/input/
kaggle/working/

# Kaggle API credentials
kaggle.json

# Docker wrapper - ignore copied competition module and build artifacts
docker_wrapper/
docker_wrapper/jpx_tokyo_market_prediction/
docker_wrapper/*.so
docker_wrapper/__pycache__/

# ============================================================================
# JUPYTER NOTEBOOKS & OUTPUTS
# ============================================================================
# Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Jupyter Notebook outputs (keep source notebooks, ignore outputs)
*.ipynb_checkpoints

# JupyterLab settings
.jupyter/

# ============================================================================
# MODEL ARTIFACTS & TRAINING OUTPUTS
# ============================================================================
# Trained models
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.safetensors

# Model checkpoints
checkpoints/
models/
saved_models/

# Training logs and progress
training_progress.txt
*.log
logs/
wandb/

# Optuna database files
*.db
optuna_study.db

# ============================================================================
# DATA FILES
# ============================================================================
# CSV/Parquet data files
*.csv
*.parquet
*.feather
*.arrow

# Compressed data
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Excel files
*.xlsx
*.xls

# ============================================================================
# IDE & EDITOR CONFIGURATIONS
# ============================================================================
# VSCode
.vscode/
*.code-workspace

# Cursor
.cursor/

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Others
uv.lock

# ============================================================================
# OPERATING SYSTEM FILES
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================================================
# TEMPORARY & CACHE FILES
# ============================================================================
# General temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# Cache directories
.cache/
cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ============================================================================
# DOCUMENTATION BUILD
# ============================================================================
# Sphinx documentation
docs/_build/
docs/_static/
docs/_templates/

# mkdocs documentation
/site

# ============================================================================
# SECURITY & CREDENTIALS
# ============================================================================
# Environment variables
.env
.env.local
.env.*.local

# Secrets
secrets/
*.pem
*.key
*.cert

# ============================================================================
# BACKUP FILES
# ============================================================================
# Notebook backups (keep only the main versions)
*_bk.ipynb
*_backup.ipynb
*_old.ipynb

# ============================================================================
# DOCKER FILES
# ============================================================================
# Docker build artifacts
*.dockerignore
docker-compose.override.yml

# Docker images (keep Dockerfile and source scripts)
docker_wrapper/*.tar

# ============================================================================
# EXCEPTIONS - KEEP THESE FILES
# ============================================================================
# Keep project configuration
!pyproject.toml

# Keep README and documentation
!README.md
!LICENSE

# Keep source code modules
!jpx_ranker/_src/*.py
!jpx_ranker/__init__.py
!jpx_ranker/kaggle_setup.py
!jpx_ranker/kaggle_submission.py

# Keep docker wrapper source files (but not copied competition module)
!docker_wrapper/Dockerfile
!docker_wrapper/submission_wrapper.py
!docker_wrapper/kaggle_docker_submission.py
!docker_wrapper/README.md
!docker_wrapper/__init__.py

# Keep main notebooks (but not backups)
!jpx_ranker/JPX_v1.ipynb
